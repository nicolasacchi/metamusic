#!/usr/bin/env bash
# Usage: scripts/loop <target> -- <command...>
# Runs the command (output streams through), then appends one metrics row to
# $MM_METRICS_FILE (default: <git-common-dir>/../metrics/loop.jsonl, shared by
# all worktrees). The row never contains the command line, paths or secrets.
set -uo pipefail

usage() { echo "usage: $0 <target> -- <command...>" >&2; exit 2; }
[ $# -ge 3 ] || usage
target=$1
[ "$2" = "--" ] || usage
shift 2

case "$target" in
  check | test | race | lint | web | e2e | build | openapi | gate | gate-full | verify | docker | fixture-db | cover | routing | seed | worker | contract | canary) ;;
  *) echo "loop: target '$target' not in allowlist" >&2; exit 2 ;;
esac

# Heavy targets (whole-repo suites) are serialised machine-wide and memory-capped.
# Single place to extend the list.
heavy=0
case "$target" in check | test | race | cover | e2e) heavy=1 ;; esac
# verify is light by default (a docs/scripts/web-unit-only change); scripts/verify.sh sets MM_LOOP_HEAVY=1 when its plan
# runs go test -race (any package) or any Playwright spec, so those runs queue and are memory-capped like `make check`.
[ "$target" = verify ] && [ "${MM_LOOP_HEAVY:-}" = 1 ] && heavy=1
# Nested loop calls (make check -> make _check) inherit the outer slot and scope.
[ -n "${MM_HEAVY_HELD:-}" ] && heavy=0

now_ns() {
  local t
  t=$(date +%s%N 2>/dev/null || true)
  case "$t" in *N* | "") t=$(($(date +%s) * 1000000000)) ;; esac
  echo "$t"
}

metrics=${MM_METRICS_FILE:-}
if [ -z "$metrics" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [ -n "$common" ]; then
    metrics="$common/../metrics/loop.jsonl"
  else
    metrics="$(cd "$(dirname "$0")/.." && pwd)/metrics/loop.jsonl"
  fi
fi

lane=$(printf '%s' "${MM_LANE:-main}" | tr '[:upper:]' '[:lower:]')
case "$lane" in
  [a-z0-9]*) ;; *) lane=main ;;
esac
lane=$(printf '%s' "$lane" | tr -c 'a-z0-9_-' '_' | cut -c1-32)

sha=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)

cache=cold
if command -v go >/dev/null 2>&1; then
  gc=$(go env GOCACHE 2>/dev/null || true)
  if [ -n "$gc" ] && [ -d "$gc" ] && [ -n "$(ls -A "$gc" 2>/dev/null | head -n1)" ]; then cache=warm; fi
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT

wait_ms=0
scoped=0
if [ "$heavy" = 1 ]; then
  if [ "${MM_HEAVY_LOCK:-1}" != 0 ] && command -v flock >/dev/null 2>&1; then
    slots=${MM_HEAVY_SLOTS:-1}
    case "$slots" in '' | *[!0-9]* | 0) slots=1 ;; esac
    lockbase=${MM_HEAVY_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/metamusic-heavy.lock}
    wstart=$(now_ns)
    announced=0
    acquired=0
    while [ "$acquired" = 0 ]; do
      i=0
      while [ "$i" -lt "$slots" ]; do
        f=$lockbase; [ "$i" -gt 0 ] && f=$lockbase.$i
        if { exec 9>>"$f"; } 2>/dev/null && flock -n 9; then acquired=1; break; fi
        exec 9>&- 2>/dev/null || true
        i=$((i + 1))
      done
      if [ "$acquired" = 0 ]; then
        if [ "$announced" = 0 ]; then
          echo "loop: waiting for a heavy-run slot (held by another suite)" >&2
          announced=1
        fi
        sleep 0.2
      fi
    done
    wait_ms=$((($(now_ns) - wstart) / 1000000))
  fi
  export MM_HEAVY_HELD=1
  if [ "${MM_HEAVY_SCOPE:-1}" != 0 ] && command -v systemd-run >/dev/null 2>&1; then
    state=$(systemctl --user is-system-running 2>/dev/null || true)
    case "$state" in running | degraded) scoped=1 ;; esac
  fi
fi
heavy_mem=${MM_HEAVY_MEM:-20G}

start=$(now_ns)

if [ "$scoped" = 1 ]; then
  systemd-run --user --scope --quiet --collect -p "MemoryMax=$heavy_mem" -p MemorySwapMax=0 -- "$@" 2>&1 | tee "$log"
else
  "$@" 2>&1 | tee "$log"
fi
rc=${PIPESTATUS[0]}
if [ "$scoped" = 1 ] && [ "$rc" = 137 ]; then
  echo "loop: killed by MemoryMax=$heavy_mem; raise MM_HEAVY_MEM or run fewer suites" >&2
fi

end=$(now_ns)
wall_ms=$(((end - start) / 1000000))

# counts come from patterns only; no output text is stored
# compile errors: go-style file:line:col: msg (optionally prefixed "vet: ") or tsc-style file(l,c): error,
# minus linter findings (end in "(name)", except "(typecheck)" which is a compile error) and ": # pkg" headers
compile_errors=$({ grep -E '^(vet: )?[^[:space:]:(]+\.(go|ts|svelte)(:[0-9]+(:[0-9]+)?: |\([0-9]+,[0-9]+\): error)' "$log" || true; } \
  | sed -E 's/ \(typecheck\)$//' | { grep -vE ': # ' || true; } | grep -cvE '\([a-z0-9-]+\)$' || true)
# svelte-check: machine format ("<ts> ERROR ...") and human format (location line followed by "Error:")
sv_errors=$({ grep -cE '^[0-9]+ ERROR "' "$log" || true; })
sv_human=$(awk '/^[^[:space:]]+\.(svelte|ts|js):[0-9]+:[0-9]+$/ { loc = 1; next } /^Error: / && loc { c++ } { loc = 0 } END { print c + 0 }' "$log")
compile_errors=$((${compile_errors:-0} + ${sv_errors:-0} + ${sv_human:-0}))
# failing tests: leaf Go "--- FAIL:" lines only (a parent whose subtests failed is not counted twice),
# plus bun "(fail)" lines and the Playwright "N failed" summary
go_failing=$(awk '
  /^[[:space:]]*--- FAIL: / { match($0, /^[[:space:]]*/); d = RLENGTH; n++; depth[n] = d; next }
  END { c = 0; for (i = 1; i <= n; i++) { leaf = 1; if (i < n && depth[i+1] > depth[i]) leaf = 0; if (leaf) c++ } print c }' "$log")
bun_failing=$(grep -cE '^\(fail\) ' "$log" || true)
pw_failing=$(sed -nE 's/^[[:space:]]+([0-9]+) failed[[:space:]]*$/\1/p' "$log" | awk '{s += $1} END {print s + 0}')
failing_tests=$((${go_failing:-0} + ${bun_failing:-0} + ${pw_failing:-0}))

mkdir -p "$(dirname "$metrics")"
printf '{"ts":"%s","target":"%s","wall_ms":%d,"wait_ms":%d,"exit":%d,"compile_errors":%d,"failing_tests":%d,"sha":"%s","lane":"%s","cache":"%s"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target" "$wall_ms" "$wait_ms" "$rc" "${compile_errors:-0}" "${failing_tests:-0}" \
  "$sha" "$lane" "$cache" >>"$metrics"

exit "$rc"
