{
  "name": "metamusic-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.ts && bun scripts/precache.ts",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.test.json && tsc -p src/api/sw/tsconfig.json",
    "test": "bun test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "abcjs": "6.7.3",
    "openapi-fetch": "^0.17.0",
    "uqr": "0.1.3"
  }
}
