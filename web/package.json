{
  "name": "metamusic-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.ts && bun scripts/precache.ts",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.test.json && tsc -p src/api/sw/tsconfig.json",
    "test": "bun test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "uqr": "0.1.3"
  }
}
