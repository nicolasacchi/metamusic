{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm.worker/1 job output",
  "description": "Returned as the RunPod job output and uploaded as mm-result.json (C73.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "take_id",
    "attempt_id",
    "status",
    "error",
    "artifacts",
    "audio_seconds",
    "truncated",
    "timings",
    "env"
  ],
  "properties": {
    "contract": {
      "const": "mm.worker/1"
    },
    "take_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "BAD_INPUT",
                "CONTRACT_VERSION",
                "WEIGHTS_MISMATCH",
                "PIPELINE_ERROR",
                "TRUNCATED_NOT_DICT",
                "ARTIFACT_MISSING",
                "ARTIFACT_TOO_LARGE",
                "UPLOAD_FAILED",
                "UPLOAD_CONFLICT",
                "UPLOAD_CLOSED",
                "ATTEMPT_CLOSED",
                "START_FAILED",
                "DEADLINE"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio.flac": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "request.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "config.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "result.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "score.abc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "plan.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "plan_manifest.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "abc_tokens.npy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "prefix.npy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "semantic.npy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "audio_seconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "truncated": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "abc",
            "semantic"
          ],
          "properties": {
            "abc": {
              "type": "boolean"
            },
            "semantic": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "pkg_version",
        "code_commit",
        "decoder",
        "gpu_name",
        "cuda",
        "torch",
        "worker_build",
        "python",
        "weights"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "pkg_version": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "decoder": {
          "type": "string"
        },
        "gpu_name": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        },
        "torch": {
          "type": "string"
        },
        "worker_build": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "truncated": {
            "type": "object"
          },
          "audio_seconds": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
