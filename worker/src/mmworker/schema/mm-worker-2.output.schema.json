    "audio_seconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "truncated": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "abc",
            "semantic"
          ],
          "properties": {
            "abc": {
              "type": "boolean"
            },
            "semantic": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "pkg_version",
        "code_commit",
        "decoder",
        "gpu_name",
        "cuda",
        "torch",
        "worker_build",
        "python",
        "weights"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "pkg_version": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "decoder": {
