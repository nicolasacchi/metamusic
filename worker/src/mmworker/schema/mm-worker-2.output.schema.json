        },
        "gpu_name": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        },
        "torch": {
          "type": "string"
        },
        "worker_build": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "kind": {
      "enum": [
        "render",
        "analyze",
        "plan"
      ]
    },
    "ears": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "error",
            "skipped"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "plans": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "seed",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "seed": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "truncated": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "bundle": {
            "type": "string",
            "pattern": "^plan-(0[0-9]|1[0-5])\\.tar$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "required": [
                "bundle"
              ]
            },
            "else": {
              "required": [
                "code"
              ],
              "properties": {
                "bundle": false
              }
            }
          }
        ]
      }
    },
    "caps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "v2",
          "ears",
          "analyze",
          "plan",
          "attach",
          "fallback",
          "agent"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "render"
          }
        }
      },
      "then": {
        "properties": {
          "plans": false
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "truncated": {
                  "type": "object"
                },
                "audio_seconds": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "analyze"
          }
        }
      },
      "then": {
        "properties": {
          "plans": false,
          "truncated": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "ears"
              ],
              "properties": {
                "ears": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                },
                "audio_seconds": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "ears": false,
          "audio_seconds": {
            "type": "null"
          },
          "truncated": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "plans"
              ],
              "properties": {
                "plans": {
                  "contains": {
                    "properties": {
                      "status": {
                        "const": "ok"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
