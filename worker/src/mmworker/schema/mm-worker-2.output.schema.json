{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm.worker/2 job output",
  "description": "Returned as the RunPod job output and uploaded as mm-result.json (C321.4): the /1 object plus kind, ears, plans and caps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "take_id",
    "attempt_id",
    "status",
    "error",
    "artifacts",
    "audio_seconds",
    "truncated",
    "timings",
    "env",
    "kind"
  ],
  "properties": {
    "contract": {
      "const": "mm.worker/2"
    },
    "take_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "BAD_INPUT",
                "CONTRACT_VERSION",
                "WEIGHTS_MISMATCH",
                "PIPELINE_ERROR",
                "TRUNCATED_NOT_DICT",
                "ARTIFACT_MISSING",
                "ARTIFACT_TOO_LARGE",
                "UPLOAD_FAILED",
                "UPLOAD_CONFLICT",
                "UPLOAD_CLOSED",
                "ATTEMPT_CLOSED",
                "START_FAILED",
                "DEADLINE",
                "INPUT_FAILED",
                "INPUT_MISMATCH",
                "KIND_UNAVAILABLE",
                "ATTACH_MISMATCH",
                "ANALYZE_FAILED",
                "PLANS_FAILED"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      ]
    },
    "artifacts": {
